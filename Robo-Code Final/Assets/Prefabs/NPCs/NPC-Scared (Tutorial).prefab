  npcName: 'Scared'
  questId: scared_tutorial
  offerLines:
  - 'AHHHH! A Clanker made it into the Haven! Please, someone destroy it!'
  hint: 'To start combat with an enemy, hit them by pressing {Attack}. Letting an enemy attack you first gives them the advantage, so always attack first!'
  reminderLines:
  - 'It''s still out there! Please, destroy it!'
  completeLines:
  - 'Phew... you got it! Thank you!'
  - 'Here are {reward} coins.'
  afterLines:
  - 'If you get hurt, open your backpack with {Inventory} and click a potion twice to drink it.'
  - 'You can also right-click a potion to equip it, then press {UseItem} to drink it any time.'
  - 'Or just press H to drink your weakest healing potion!'
  rewardCoins: 15
  includeBosses: 0
  questClip: scared
  doneClip: thumbsUp
  talkRange: 1.8
  promptHeight: 1.8
